{
  "name": "sector7-fps",
  "version": "1.0.2",
  "description": "SECTOR 7 — мини-FPS на Three.js (Electron)",
  "author": "Лев Афанасьев",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lev.sector7",
    "productName": "SECTOR 7",
    "files": [
      "main.js",
      "index.html",
      "vendor/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SECTOR7-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "SECTOR7-${version}-portable.${ext}"
    }
  }
}
